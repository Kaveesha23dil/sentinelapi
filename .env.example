# Copy to .env locally and replace the placeholder with a randomly generated secret.
# Never commit .env. No database port is published on Windows.
POSTGRES_DB=sentinelapi
POSTGRES_USER=sentinelapi_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
MONITORING_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Non-secret identity of the existing local published API.
WSO2_API_ID=f0d23a14-460c-4441-9c76-0f39bfd2efb3
COLLECTOR_DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MONITORING_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
