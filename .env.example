# Copy to .env locally and replace the placeholder with a randomly generated secret.
# Never commit .env. No database port is published on Windows.
POSTGRES_DB=sentinelapi
POSTGRES_USER=sentinelapi_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
MONITORING_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Non-secret identity of the existing local published API.
WSO2_API_ID=f0d23a14-460c-4441-9c76-0f39bfd2efb3
COLLECTOR_DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MONITORING_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# compose.step6.yaml: distinct DB credentials and role-specific bearer tokens.
DETECTOR_DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECURITY_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECURITY_READER_TOKEN=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECURITY_ANALYST_TOKEN=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECURITY_ADMIN_TOKEN=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional compose.step7.yaml. Set only after operator artifact review.
# ML_MODEL_HOST_DIR points to one immutable model-version directory.
# ML_MODEL_HOST_DIR=
# ML_APPROVED_SHA256=
ML_ALLOW_EXPERIMENTAL=false
